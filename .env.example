# ============================================================
# ForFuture — Environment Configuration
# ============================================================

# Data Mode: LIVE (default) or MOCK
# In LIVE mode, Forex data flows from the highest-priority healthy provider:
# Priority 1: OANDA -> Priority 2: FXCM -> Priority 3: Twelve Data -> Priority 4: FOREX.com
# If no provider credentials are configured or all fail, Forex charts display 'DATA UNAVAILABLE'.
# In MOCK mode, high-fidelity synthetic candles are generated for offline development.
DATA_MODE=LIVE

# Backend HTTP & WebSocket Port
PORT=3001

# ============================================================
# 1. PRIMARY FOREX PROVIDER: OANDA (v20 REST + Pricing Stream)
# ============================================================
# OANDA Environment: 'practice' (default/development) or 'live' (production)
OANDA_ENV=practice
# OANDA v20 Account ID (e.g. 101-001-1234567-001)
OANDA_ACCOUNT_ID=
# OANDA v20 Personal Access API Bearer Token
# Practice token: https://fxtrade.oanda.com/your_account/fxtrade/register/demo
# Live token: https://fxtrade.oanda.com/your_account/fxtrade/register/live
OANDA_API_TOKEN=

# ============================================================
# 2. BACKUP FOREX PROVIDER: FXCM (REST API)
# ============================================================
# FXCM API Token from Trading Station / FXCM account
# Demo portal: https://tradingstation.fxcm.com/
FXCM_API_TOKEN=
FXCM_ENV=demo
FXCM_ACCOUNT_ID=

# ============================================================
# 3. BACKUP FOREX PROVIDER: TWELVE DATA (REST API)
# ============================================================
# Twelve Data API Key from https://twelvedata.com
TWELVE_DATA_API_KEY=

# ============================================================
# 4. BACKUP FOREX PROVIDER: FOREX.COM / GAIN CAPITAL (CIAPI)
# ============================================================
# FOREX.com OpenAPI / CIAPI Credentials
FOREX_COM_USERNAME=
FOREX_COM_PASSWORD=
FOREX_COM_APPKEY=
FOREX_COM_ENV=demo

# ============================================================
# FAILOVER & HEALTH MONITORING ENGINE CONFIGURATION
# ============================================================
# Enable automatic provider failover (true/false)
FAILOVER_ENABLED=true
# Consecutive errors before marking a provider as FAILED (default: 3)
PROVIDER_FAILURE_THRESHOLD=3
# Health check heartbeat interval in ms (default: 15000)
PROVIDER_HEALTH_CHECK_INTERVAL_MS=15000
# Cooldown period before re-probing a failed provider in ms (default: 60000)
PROVIDER_COOLDOWN_MS=60000
# Staleness threshold before declaring provider unresponsive in ms (default: 20000)
STALE_DATA_THRESHOLD_MS=20000
